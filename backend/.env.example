# Required for Prisma/PostgreSQL features. Set this to your Neon connection string.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Backend HTTP and authentication
PORT=5000
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: Chapa payments
CHAPA_BASE_URL="https://api.chapa.co/v1/transaction/initialize"
CHAPA_SECRET_KEY=""

# Optional: TextBee SMS
TEXTBEE_DEVICE_ID=""
TEXTBEE_API_KEY=""

# Required to deliver signup verification codes by email (Gmail app password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-address@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
EMAIL_FROM="your-address@gmail.com"
